# ============================================================================
# VARIABLES D'ENVIRONNEMENT DOOLÉ
# ============================================================================
# Copie ce fichier en .env.local pour développement local
# Configure ces variables sur Vercel pour production/preview/development
# ============================================================================

# ============================================================================
# SUPABASE (Requis)
# ============================================================================
# Récupérés depuis https://app.supabase.com/project/[PROJECT_ID]/settings/api

# URL publique du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clé publique (anon) - exposée au client (safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé service-role - SERVEUR UNIQUEMENT - NE JAMAIS EXPOSER AU CLIENT
# Utilisée pour les webhooks et Server Actions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# URL PUBLIQUE DE L'APPLICATION
# ============================================================================
# Utilisée pour les SMS de confirmation et les liens de suivi

# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production (remplace avec ton domaine)
# NEXT_PUBLIC_APP_URL=https://doole.sn

# Preview sur Vercel (remplace avec ton domaine preview)
# NEXT_PUBLIC_APP_URL=https://mon-projet-saas-doolee-preview.vercel.app

# ============================================================================
# BREVO SMS (Requis)
# ============================================================================
# Récupérés depuis https://app.brevo.com/account/

# Clé API Brevo pour envoyer les SMS OTP et confirmations
BREVO_API_KEY=xkeysib-...

# Nom d'expéditeur SMS (affiché aux clients)
BREVO_SMS_SENDER=Doole

# ============================================================================
# MONEROO (Paiement - Requis)
# ============================================================================
# Récupérés depuis https://dashboard.moneroo.io/

# Clé API pour créer les sessions de paiement
MONEROO_API_KEY=sk_live_...

# Secret pour vérifier les signatures des webhooks Moneroo
MONEROO_WEBHOOK_SECRET=whsec_...

# ============================================================================
# NOTES
# ============================================================================
# 1. Toutes les variables ci-dessus sont REQUISES
# 2. Ne commit JAMAIS ce fichier (.env.local ou les clés)
# 3. Sur Vercel, configure les mêmes variables dans Settings > Environment Variables
#    en les appliquant aux 3 environnements: Production, Preview, Development
# 4. Les variables NEXT_PUBLIC_* sont exposées au client (public)
# 5. Les autres sont côté serveur seulement et sécurisées
